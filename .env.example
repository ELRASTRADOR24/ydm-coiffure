# URL publique de l'application (en ligne)
NEXT_PUBLIC_APP_URL=https://www.ydmcoiffure.com

# Base de données MongoDB Atlas
# Remplacer par votre chaîne de connexion MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ydm_coiffure?retryWrites=true&w=majority

# Sécurité & Authentification Administrateur
AUTH_SECRET=ydm_coiffure_super_secret_jwt_key_2026_luxury_braids_salon_paris
ADMIN_EMAIL=admin@ydm-coiffure.fr
ADMIN_PASSWORD=YdmLuxe2026!

# Paiements directs (Wero, Revolut, PayPal — Stripe non utilisé)
# Les coordonnées directes sont configurables depuis /admin/settings.

# Resend (E-mails transactionnels)
RESEND_API_KEY=re_...
EMAIL_FROM=YDM Coiffure <contact@ydm-coiffure.fr>
ADMIN_NOTIFICATION_EMAIL=contact@ydm-coiffure.fr

# Twilio (SMS transactionnels & rappels)
TWILIO_ACCOUNT_SID=AC0d1dd...
